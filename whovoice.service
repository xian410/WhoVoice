[Unit]
Description=WhoVoice Voice Recognition Service
After=network.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ljx/WhoVoice/backend
Environment="INFERENCE_DEVICE=cpu"
Environment="DJANGO_DEBUG=True"
ExecStart=/home/ubuntu/ljx/WhoVoice/venv/bin/gunicorn whovoice.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile /home/ubuntu/ljx/whovoice_access.log \
    --error-logfile /home/ubuntu/ljx/whovoice_error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
